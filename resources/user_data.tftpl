!#/bin/bash

PUBLIC_IP=$(curl -s http://169.254.169.254/latest/meta-data/public-ipv4)

sudo apt update && sudo apt install -y wireguard

wg genkey | sudo tee /etc/wireguard/server_priv.key | wg pubkey | sudo tee /etc/wireguard/server_pub.key
wg genkey | sudo tee /etc/wireguard/peer_priv.key | wg pubkey | sudo tee /etc/wireguard/peer_pub.key
wg genpsk | sudo tee /etc/wireguard/peer_psk.key

cat <<EOF > /etc/wireguard/server.conf
[Interface]
Address = 10.255.255.254/32
ListenPort = ${port}
PrivateKey = $(cat /etc/wireguard/server_priv.key)
PreUp = echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/10-forward_ipv4.conf; sudo sysctl -f /etc/sysctl.d/10-forward_ipv4.conf

[Peer]
PublicKey = $(cat /etc/wireguard/peer_pub.key)
PresharedKey = $(cat /etc/wireguard/peer_psk.key)
AllowedIPs = 10.255.255.253/32
PersistentKeepAlive = 25
EOF

cat <<EOF > /etc/wireguard/peer.conf
[Interface]
Address = 10.255.255.253/32
PrivateKey = $(cat /etc/wireguard/peer_priv.key)
DNS = 10.255.255.253

[Peer]
PublicKey = $(cat /etc/wireguard/server_pub.key)
PresharedKey = $(cat /etc/wireguard/peer_psk.key)
Endpoint = $PUBLIC_IP:51820
AllowedIPs = 0.0.0.0/0
EOF

sudo wg-quick up server