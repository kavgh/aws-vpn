#!/bin/bash

sudo apt-get update && sudo apt-get install -y wireguard

wg genkey | sudo tee /etc/wireguard/server.priv | wg pubkey | sudo tee /etc/wireguard/server.pub
wg genkey | sudo tee /etc/wireguard/peer_laptop.priv | wg pubkey | sudo tee /etc/wireguard/peer_laptop.pub
wg genkey | sudo tee /etc/wireguard/peer_phone.priv | wg pubkey | sudo tee /etc/wireguard/peer_phone.pub
wg genpsk | sudo tee /etc/wireguard/peer_laptop.psk
wg genpsk | sudo tee /etc/wireguard/peer_phone.psk

###### Allow send requests to the global internet from this server
echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/10-forward_ipv4.conf; sudo sysctl -p

SERVER_PRIV=$(sudo cat /etc/wireguard/server.priv)
SERVER_PUB=$(sudo cat /etc/wireguard/server.pub)
PEER_LAPTOP_PUB=$(sudo cat /etc/wireguard/peer_laptop.pub)
PEER_LAPTOP_PSK=$(sudo cat /etc/wireguard/peer_laptop.psk)
PEER_LAPTOP_PRIV=$(sudo cat /etc/wireguard/peer_laptop.priv)
PEER_PHONE_PUB=$(sudo cat /etc/wireguard/peer_phone.pub)
PEER_PHONE_PSK=$(sudo cat /etc/wireguard/peer_phone.psk)
PEER_PHONE_PRIV=$(sudo cat /etc/wireguard/peer_phone.priv)
PUBLIC_IP=$(dig +short myip.opendns.com @resolver1.opendns.com)

cat <<EOF | sudo tee /etc/wireguard/server.conf
[Interface]
Address = 10.255.255.254/32
ListenPort = ${port}
PrivateKey = $SERVER_PRIV

[Peer]
# laptop
PublicKey = $PEER_LAPTOP_PUB
PresharedKey = $PEER_LAPTOP_PSK
AllowedIPs = 10.255.255.253/32
PersistentKeepAlive = 25

[Peer]
# phone
PublicKey = $PEER_PHONE_PUB
PresharedKey = $PEER_LAPTOP_PSK
AllowedIPs = 10.255.255.252/32
PersistentKeepAlive = 25
EOF

cat <<EOF | sudo tee /etc/wireguard/peer_laptop.conf
[Interface]
Address = 10.255.255.253/32
PrivateKey = $PEER_LAPTOP_PRIV
DNS = 10.255.255.253

[Peer]
PublicKey = $SERVER_PUB
PresharedKey = $PEER_PHONE_PSK
Endpoint = $PUBLIC_IP:51820
AllowedIPs = 0.0.0.0/0
EOF

cat <<EOF | sudo tee /etc/wireguard/peer_phone.conf
[Interface]
Address = 10.255.255.252/32
PrivateKey = $PEER_PHONE_PRIV
DNS = 10.255.255.253

[Peer]
PublicKey = $SERVER_PUB
PresharedKey = $PEER_PHONE_PSK
Endpoint = $PUBLIC_IP:51820
AllowedIPs = 0.0.0.0/0
EOF

sudo wg-quick up server